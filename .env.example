# OpenRouter API configuration
OPENROUTER_MODEL=openrouter/arcee-ai/trinity-large-preview:free
OPENROUTER_TEMPERATURE=0.0
OPENROUTER_TIMEOUT=30

# Qdrant configuration
QDRANT_HOST=qdrant
## Collection
COLLECTION_NAME=support_tickets
TOP_K=10
## Chunking
CHUNK_SIZE=512
## Embedding models configuration
EMBEDDING_MODEL=LiquidAI/LFM2-ColBERT-350M
EMBEDDING_DIMENSION=128
SPARSE_MODEL=Qdrant/bm25
## Reranker
RERANKER_MODEL=LiquidAI/LFM2-ColBERT-350M

# SMTP Configuration for DLQ Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_adresse@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_app
ALERT_EMAIL_TO=admin@example.com
